# ============================================
# SAE 5C03 - Configuration Environment
# ============================================
# Copiez ce fichier vers .env et adaptez les valeurs
# cp .env.example .env
#
# ⚠️  NE JAMAIS COMMITER LE FICHIER .env
# ============================================

# -----------------------------
# GOAD Lab (VirtualBox)
# -----------------------------
GOAD_NETWORK=192.168.56.0/24
GOAD_DC01_IP=192.168.56.10
GOAD_DC02_IP=192.168.56.11
GOAD_SRV02_IP=192.168.56.22
GOAD_WKS01_IP=192.168.56.110
GOAD_WKS02_IP=192.168.56.111

# Domain credentials (LAB ONLY - change these!)
GOAD_DOMAIN_ADMIN=Administrator
GOAD_DOMAIN_PASSWORD=changeme123!

# -----------------------------
# OpenWEC
# -----------------------------
OPENWEC_IP=192.168.56.200
OPENWEC_HTTP_PORT=5985
OPENWEC_HTTPS_PORT=5986
OPENWEC_LOG_LEVEL=INFO

# -----------------------------
# Elasticsearch Stack
# -----------------------------
ELASTIC_VERSION=8.11.0
ELASTIC_IP=192.168.56.201
ELASTIC_PORT=9200
KIBANA_PORT=5601

# Credentials (CHANGE THESE!)
ELASTIC_USER=elastic
ELASTIC_PASSWORD=changeme

# Resources
ELASTIC_MEMORY=4g
LOGSTASH_MEMORY=2g

# -----------------------------
# Wazuh SIEM
# -----------------------------
WAZUH_VERSION=4.7.0
WAZUH_MANAGER_IP=192.168.56.202
WAZUH_AGENT_PORT=1514
WAZUH_API_PORT=55000
WAZUH_DASHBOARD_PORT=443

# Credentials (CHANGE THESE!)
WAZUH_API_USER=wazuh-wui
WAZUH_API_PASSWORD=changeme

# -----------------------------
# Suricata IDS
# -----------------------------
SURICATA_IP=192.168.56.203
SURICATA_HOME_NET="192.168.56.0/24"
SURICATA_EXTERNAL_NET="!$HOME_NET"
SURICATA_INTERFACE=eth1

# Rules update
SURICATA_RULES_UPDATE=daily

# -----------------------------
# Sysmon
# -----------------------------
SYSMON_VERSION=15.0
SYSMON_CONFIG_URL="https://raw.githubusercontent.com/SwiftOnSecurity/sysmon-config/master/sysmonconfig-export.xml"
